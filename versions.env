# The curl-for-win package this repository tracks: <curl-version>_<their
# build revision>, one token exactly as curl.se serves it, so Renovate can
# watch the curl.se download index and bump it (see renovate.json). The
# scripts split it into CURL_VERSION and CFW_REV.
# Our release tag is v<curl-version> — or v<curl-version>.<n> when we rebuild
# without an upstream bump (n = 1, 2, ...; a 4th segment, NEVER a -suffix:
# semver sorts X.Y.Z-1 BEFORE X.Y.Z).
# renovate: depName=curl-for-win
CFW_PACKAGE=8.23.0_1

# The curl-for-win commit the posix builds run at, and the provenance of the
# vendored cosign.pub.asc. Bumping this pin means re-auditing their scripts —
# a deliberate, human act, not a Renovate one.
CFW_COMMIT=f478a7cc3c6f6bf00bf0745e3a55a129b8a5ec2b

# The image the linux legs build in, pinned by digest (Renovate moves it: the
# docker manager in renovate.json tracks the tag, the digest is the pin), and
# the apt they install from: snapshot.debian.org at APT_SNAPSHOT, so every
# package is the one that timestamp held. DEBIAN_SUITE must match the image's
# codename. A snapshot timestamp has no Renovate datasource — bump it by hand
# with the image, to one newer than it (https://snapshot.debian.org/archive/debian/).
BUILD_IMAGE=mirror.gcr.io/library/debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
DEBIAN_SUITE=trixie
APT_SNAPSHOT=20261003T204240Z
